      "--chart-4",
      "--chart-5",
      "--chart-ink",
      "--destructive",
      "--destructive-foreground",
      "--elevation-0",
      "--elevation-1",
      "--elevation-2",
      "--font-body",
      "--font-heading",
      "--font-sans",
      "--foreground",
      "--fs-body",
      "--fs-display",
      "--fs-eyebrow",
      "--fs-headline",
      "--fs-label",
      "--fs-subhead",
      "--fw-body",
      "--fw-display",
      "--fw-eyebrow",
      "--fw-headline",
      "--fw-label",
      "--fw-subhead",
      "--graph-1",
      "--input",
      "--lh-body",
      "--lh-display",
      "--lh-eyebrow",
      "--lh-headline",
      "--lh-label",
      "--lh-subhead",
      "--muted",
      "--muted-foreground",
      "--primary",
